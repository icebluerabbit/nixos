# Relocate direnv cache/layouts to home directory to support exfat mounts (which lack symlink support)
: "${XDG_CACHE_HOME:=$HOME/.cache}"
declare -A direnv_layout_dirs
direnv_layout_dir() {
  echo "${direnv_layout_dirs[$PWD]:=$(
    echo -n "$XDG_CACHE_HOME"/direnv/layouts/
    echo -n "$PWD" | sha1sum | cut -d ' ' -f 1
  )}"
}

# Each export below is split into assign-then-export: `export VAR=$(cmd)` makes
# the exit status of the assignment always 0, masking a failing `cat` (SC2155).

# Export UniFi API Key for Terranix if decrypted by sops-nix in Home Manager
if [ -f ~/.config/sops-nix/secrets/unifi-local-api-key ]; then
  UNIFI_API_KEY=$(cat ~/.config/sops-nix/secrets/unifi-local-api-key)
  export UNIFI_API_KEY
fi

# Export Wi-Fi passphrase for Terranix if decrypted by sops-nix in Home Manager
if [ -f ~/.config/sops-nix/secrets/wifi-passphrase ]; then
  TF_VAR_wifi_passphrase=$(cat ~/.config/sops-nix/secrets/wifi-passphrase)
  export TF_VAR_wifi_passphrase
fi

# Export RADIUS secret for Terranix if decrypted by sops-nix in Home Manager
if [ -f ~/.config/sops-nix/secrets/radius-secret ]; then
  TF_VAR_radius_secret=$(cat ~/.config/sops-nix/secrets/radius-secret)
  export TF_VAR_radius_secret
fi

# Export Dynamic DNS password for Terranix if decrypted by sops-nix in Home Manager
if [ -f ~/.config/sops-nix/secrets/dyndns-password ]; then
  TF_VAR_dyndns_password=$(cat ~/.config/sops-nix/secrets/dyndns-password)
  export TF_VAR_dyndns_password
fi

# Export Cloudflare API token for Terranix if decrypted by sops-nix in Home Manager
if [ -f ~/.config/sops-nix/secrets/cloudflare-api-token ]; then
  CLOUDFLARE_API_TOKEN=$(cat ~/.config/sops-nix/secrets/cloudflare-api-token)
  export CLOUDFLARE_API_TOKEN
fi

# Export Gitea API token for Terranix (gitea provider auth) if decrypted by sops-nix
if [ -f ~/.config/sops-nix/secrets/gitea-api-token ]; then
  GITEA_TOKEN=$(cat ~/.config/sops-nix/secrets/gitea-api-token)
  export GITEA_TOKEN
fi

# Export GitHub token for Gitea repo migration + push-mirror if decrypted by sops-nix
if [ -f ~/.config/sops-nix/secrets/github-access-token-nixos ]; then
  TF_VAR_github_token=$(cat ~/.config/sops-nix/secrets/github-access-token-nixos)
  export TF_VAR_github_token
fi

if [ -f ~/.config/sops-nix/secrets/cloudflare-zone-name ]; then
  TF_VAR_cf_zone_name=$(cat ~/.config/sops-nix/secrets/cloudflare-zone-name)
  export TF_VAR_cf_zone_name
fi

if [ -f ~/.config/sops-nix/secrets/cloudflare-record-name ]; then
  TF_VAR_cf_record_name=$(cat ~/.config/sops-nix/secrets/cloudflare-record-name)
  export TF_VAR_cf_record_name
fi

if [ -f ~/.config/sops-nix/secrets/cloudflare-account-id ]; then
  TF_VAR_cf_account_id=$(cat ~/.config/sops-nix/secrets/cloudflare-account-id)
  export TF_VAR_cf_account_id
fi

if [ -f ~/.config/sops-nix/secrets/cloudflare-zone-id ]; then
  TF_VAR_cf_zone_id=$(cat ~/.config/sops-nix/secrets/cloudflare-zone-id)
  export TF_VAR_cf_zone_id
fi

if [ -f ~/.config/sops-nix/secrets/wan-ip ]; then
  TF_VAR_wan_ip=$(cat ~/.config/sops-nix/secrets/wan-ip)
  export TF_VAR_wan_ip
fi

use flake
