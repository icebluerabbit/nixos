/*
  formatter — repository-wide code formatter configuration
  https://github.com/numtide/treefmt-nix

  One formatter per language, driven by treefmt so `nix fmt` covers the whole
  tree rather than Nix alone:

    nix       nixfmt-rfc-style
    python    ruff-format + ruff-check (config: ../ruff.toml, line-length 79 —
              packages/* build with writers.writePython3Bin, whose flake8 pass
              enforces the same 79 columns with no ignores)
    go        gofmt (packages/go, which is now every Go module in the
              repo). Linting is separate: golangci-lint runs through
              `just go-lint`, configured in packages/go/.golangci.yml,
              because it needs the module graph rather than a file list.
    shell     shfmt + shellcheck
    lua       stylua (config: ../stylua.toml, auto-discovered rather than
              passed, so conform-nvim and a bare `stylua` agree with the hook)
    markdown  prettier, restricted to *.md — it is the only markdown formatter
              here that preserves YAML frontmatter, which the skills under
              modules/cli/claude/skills depend on. Left unrestricted it would
              also rewrite every JSON/YAML in the tree, including sops files.

  git-hooks.nix runs this same wrapper pre-commit, so the hook and `nix fmt`
  can never disagree.
*/
{ inputs, ... }:
{
  flake-file.inputs = {
    treefmt-nix = {
      url = "github:numtide/treefmt-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  imports = if inputs ? treefmt-nix then [ inputs.treefmt-nix.flakeModule ] else [ ];

  perSystem =
    { pkgs, ... }:
    if inputs ? treefmt-nix then
      {
        treefmt = {
          projectRootFile = "flake.nix";
          programs = {
            nixfmt.enable = true;
            ruff-format.enable = true;
            ruff-check.enable = true;
            gofmt.enable = true;
            shfmt.enable = true;
            shellcheck.enable = true;
            stylua.enable = true;
            prettier.enable = true;
          };
          settings = {
            # Markdown only. Everything else prettier claims (json, yaml, css)
            # is either generated or sops-encrypted here.
            formatter.prettier.includes = [ "*.md" ];
            global.excludes = [
              # Generated by flake-file; regenerate with `just flake`.
              "flake.nix"
              # Symlink into the nix store.
              ".pre-commit-config.yaml"
              "result"
              # sops ciphertext — reformatting invalidates the MAC.
              "secrets/**"
              # Vendored terraform providers and state.
              "homelab/.terraform/**"
              "homelab/*.tfstate*"
            ];
          };
        };
      }
    else
      {
        formatter = pkgs.nixfmt-tree;
      };
}
