<b>📚 LazyLibrarian</b> · <font color="#ed4245">❌ Download failed</font>
{% set p = trigger.payload_json %}
<ul>
<li><b>Book:</b> {{ p.BookName | default('—') }}{% if p.BookSub %} <i>{{ p.BookSub }}</i>{% endif %}</li>
<li><b>Author:</b> {{ p.AuthorName | default('—') }}</li>
<li><b>Type:</b> {{ p.AuxInfo | default('—') }}</li>
<li><b>Release:</b> <code>{{ p.NZBtitle | default('—') }}</code></li>
<li><b>Indexer:</b> {{ p.NZBprov | default('—') }}</li>
<li><b>Client:</b> {{ p.Source | default('—') }}</li>
<li><b>Result:</b> {{ p.DLResult | default('—') }}</li>
<li><b>Status:</b> {{ p.Wanted_Status | default(p.Status) | default('—') }}</li>
<li><b>BookID:</b> <code>{{ p.BookID | default('—') }}</code></li>
</ul>
