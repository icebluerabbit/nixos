{% set p = trigger.payload_json.payload %}📥 <b>MaM · grab</b>
<b>{{ p.name }}</b>
<ul>
<li><b>Media type:</b> {{ p.media_type | default('—') }}</li>
<li><b>Categories:</b> {{ (p.categories or []) | join(', ') | default('—', true) }}</li>
<li><b>Size:</b> {% if p.size %}{{ (p.size / 1073741824) | round(2) }} GiB{% else %}—{% endif %}</li>
<li><b>Result:</b> <code>{{ p.result | default('—') }}</code></li>
</ul>
