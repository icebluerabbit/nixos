<b>🎬 Radarr</b> · <font color="#57f287">⬇️ Download</font>{% if trigger.payload_json.isUpgrade %} ⬆️{% endif %}
{% set m = trigger.payload_json.movie | default({}, true) %}
{% set mf = trigger.payload_json.movieFile | default({}, true) %}
{% set mi = mf.mediaInfo | default({}, true) %}
{% set rel = trigger.payload_json.release | default({}, true) %}
<ul>
<li><b>Movie:</b> {{ m.title | default('—') }} ({{ m.year | default('') }})</li>
<li><b>IMDb:</b> {{ m.imdbId | default('—') }} | <b>TMDb:</b> {{ m.tmdbId | default('—') }}</li>
<li><b>File:</b> <code>{{ mf.relativePath | default('—') }}</code></li>
<li><b>Quality:</b> {{ mf.quality | default('—') }}</li>
<li><b>Group:</b> {{ mf.releaseGroup | default('—') }}</li>
<li><b>Video:</b> {{ mi.videoCodec | default('—') }} {{ mi.width | default('') }}×{{ mi.height | default('') }}</li>
<li><b>Audio:</b> {{ mi.audioCodec | default('—') }} {{ mi.audioChannels | default('') }}ch</li>
<li><b>Subs:</b> {{ mi.subtitles | default([]) | join(', ') | default('none') }}</li>
<li><b>HDR:</b> {{ mi.videoDynamicRangeType | default('SDR') }}</li>
<li><b>Indexer:</b> {{ rel.indexer | default('—') }}</li>
<li><b>Size:</b> {{ ((rel.size | default(0) | int) / 1073741824) | round(2) }} GiB</li>
<li><b>Formats:</b> {{ rel.customFormats | default([]) | join(', ') | default('none') }}</li>
<li><b>Score:</b> {{ rel.customFormatScore | default(0) }}</li>
<li><b>Client:</b> {{ trigger.payload_json.downloadClient | default('—') }} ({{ trigger.payload_json.downloadClientType | default('—') }})</li>
<li><b>DownloadID:</b> <code>{{ trigger.payload_json.downloadId | default('—') }}</code></li>
<li><b>Instance:</b> {{ trigger.payload_json.instanceName }}</li>
</ul>
