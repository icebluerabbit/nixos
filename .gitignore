*~
*.swp

# OS generated files
.DS_Store

# Ignore everything under .claude EXCEPT the shared skills, so contributor LLMs
# get the same canonical add-resource / add-service / architecture procedures.
.claude/*
!.claude/skills/
!.claude/skills/**

# OpenTofu environment
/*/.terraform*
/*/config.tf.json
/*/terraform.tfstate*
homelab/

MIGRATION.md
